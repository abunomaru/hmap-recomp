+// ---------------------------------------------------------------- specialised shaders
+// hmap-recomp engine patch 0012. Each distinct TEV configuration gets its own pixel shader
+// with the configuration compiled in (see the c* names in kShaderSource). Variants are
+// compiled on background threads; until one is ready its draws use the general shader, so
+// a new configuration never stalls a frame. Setting video.specialized_shaders (default on).
+
+struct ShaderKey {
+    uint32_t stage[kMaxStages][4];
+    uint32_t tevind[kMaxStages];
+    uint32_t header[4];
+    uint32_t swaps[4];
+    uint32_t indirect[4];
+    int32_t fog_mode;
+    uint32_t early;
+};
+
+ShaderKey make_shader_key(const Constants& constants, bool early) {
+    ShaderKey key;
+    std::memset(&key, 0, sizeof key);
+    uint32_t stages = std::min<uint32_t>(constants.header[0], kMaxStages);
+    for (uint32_t i = 0; i < stages; i++) {
+        std::memcpy(key.stage[i], constants.stage[i], sizeof key.stage[i]);
+        key.tevind[i] = constants.tevind[i][0];
+    }
+    std::memcpy(key.header, constants.header, sizeof key.header);
+    std::memcpy(key.swaps, constants.swaps, sizeof key.swaps);
+    std::memcpy(key.indirect, constants.indirect, sizeof key.indirect);
+    key.fog_mode = constants.fog_integer[0];
+    key.early = early ? 1u : 0u;
+    return key;
+}
+
+uint64_t hash_key(const ShaderKey& key) {
+    uint64_t value = 1469598103934665603ull;
+    const uint8_t* bytes = reinterpret_cast<const uint8_t*>(&key);
+    for (size_t i = 0; i < sizeof key; i++) {
+        value = (value ^ bytes[i]) * 1099511628211ull;
+    }
+    return value;
+}
+
+std::string specialized_source(const ShaderKey& key) {
+    std::string out = "#define SPECIALIZED\n";
+    char text[160];
+    auto vec = [&](const uint32_t* v) {
+        std::snprintf(text, sizeof text, "uint4(%uu, %uu, %uu, %uu)", v[0], v[1], v[2], v[3]);
+        return std::string(text);
+    };
+    out += "static const uint4 cstage[16] = {";
+    for (uint32_t i = 0; i < kMaxStages; i++) {
+        out += (i ? ", " : "") + vec(key.stage[i]);
+    }
+    out += "};\nstatic const uint4 ctevind[16] = {";
+    for (uint32_t i = 0; i < kMaxStages; i++) {
+        uint32_t row[4] = {key.tevind[i], 0, 0, 0};
+        out += (i ? ", " : "") + vec(row);
+    }
+    out += "};\nstatic const uint4 cheader = " + vec(key.header) + ";\n";
+    out += "static const uint4 cswaps = " + vec(key.swaps) + ";\n";
+    out += "static const uint4 cindirect = " + vec(key.indirect) + ";\n";
+    std::snprintf(text, sizeof text, "static const int cfog_mode = %d;\n", key.fog_mode);
+    out += text;
+    uint32_t stages = std::clamp<uint32_t>(key.header[0], 1, kMaxStages);
+    uint32_t indirect_stages = std::min<uint32_t>(key.indirect[0] & 7, 4);
+    std::snprintf(text, sizeof text, "#define TEV_STAGE_LIMIT %u\n#define IND_STAGE_LIMIT %u\n", stages, indirect_stages);
+    out += text;
+    std::string body = kShaderSource;
+    if (key.early) {
+        body.replace(body.find("PixelOutput pixel_main("), 0, "[earlydepthstencil] ");
+    }
+    return out + body;
+}
+
+struct ShaderVariant {
+    ShaderKey key;
+    std::atomic<ID3D11PixelShader*> shader{nullptr};
+    std::atomic<bool> failed{false};
+};
+
+class VariantCompiler {
+public:
+    void enqueue(ShaderVariant* variant) {
+        start();
+        {
+            std::lock_guard<std::mutex> hold(m_lock);
+            m_queue.push_back(variant);
+        }
+        m_wake.notify_one();
+    }
+
+private:
+    void start() {
+        if (m_started) {
+            return;
+        }
+        m_started = true;
+        unsigned cores = std::max(1u, std::thread::hardware_concurrency());
+        unsigned threads = std::clamp(cores / 4, 1u, 2u);
+        for (unsigned i = 0; i < threads; i++) {
+            std::thread([this] { run(); }).detach();
+        }
+    }
+
+    void run() {
+        while (true) {
+            ShaderVariant* variant = nullptr;
+            {
+                std::unique_lock<std::mutex> hold(m_lock);
+                m_wake.wait(hold, [this] { return !m_queue.empty(); });
+                variant = m_queue.front();
+                m_queue.pop_front();
+            }
+            auto started = std::chrono::steady_clock::now();
+            std::string source = specialized_source(variant->key);
+            ID3DBlob* code = nullptr;
+            ID3DBlob* errors = nullptr;
+            HRESULT result = D3DCompile(source.data(), source.size(), "gx_variant", nullptr, nullptr, "pixel_main", "ps_5_0",
+                                        D3DCOMPILE_OPTIMIZATION_LEVEL1, 0, &code, &errors);
+            ID3D11PixelShader* shader = nullptr;
+            if (SUCCEEDED(result) && code &&
+                SUCCEEDED(g_device.device->CreatePixelShader(code->GetBufferPointer(), code->GetBufferSize(), nullptr, &shader))) {
+                variant->shader.store(shader, std::memory_order_release);
+            } else {
+                variant->failed.store(true, std::memory_order_release);
+                static std::atomic<int> reported{0};
+                if (reported++ < 3) {
+                    std::fprintf(stderr, "specialised shader failed to compile, using the general shader: %s\n",
+                                 errors ? static_cast<const char*>(errors->GetBufferPointer()) : "no message");
+                }
+            }
+            release(code);
+            release(errors);
+            double ms = std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now() - started).count();
+            uint32_t total = ++m_compiled;
+            m_total_ms.fetch_add(static_cast<uint64_t>(ms));
+            if (total <= 5 || total % 50 == 0) {
+                log::write("shaders", "%u specialised shaders compiled (last took %.0f ms)", total, ms);
+            }
+        }
+    }
+
+    bool m_started = false;
+    std::mutex m_lock;
+    std::condition_variable m_wake;
+    std::deque<ShaderVariant*> m_queue;
+    std::atomic<uint32_t> m_compiled{0};
+    std::atomic<uint64_t> m_total_ms{0};
+
+public:
+    void statistics(uint32_t& queued, uint32_t& compiled, uint32_t& average_ms) {
+        std::lock_guard<std::mutex> hold(m_lock);
+        queued = static_cast<uint32_t>(m_queue.size());
+        compiled = m_compiled.load();
+        average_ms = compiled ? static_cast<uint32_t>(m_total_ms.load() / compiled) : 0;
+    }
+};
+
+VariantCompiler g_variant_compiler;
+std::unordered_map<uint64_t, std::unique_ptr<ShaderVariant>> g_variants;
+constexpr size_t kMaxVariants = 4096;
+uint32_t g_special_batches = 0;
+uint32_t g_general_batches = 0;
+
+// Returns the specialised shader for this batch's configuration, or nullptr while it is
+// being compiled (or if specialisation is off / failed): the caller then uses the general one.
+ID3D11PixelShader* specialized_shader(const Constants& constants, bool early) {
+    static const settings::LiveFlag enabled("video.specialized_shaders", "WP_SPECIALIZED_SHADERS");
+    if (!enabled()) {
+        return nullptr;
+    }
+    ShaderKey key = make_shader_key(constants, early);
+    uint64_t hash = hash_key(key);
+    auto it = g_variants.find(hash);
+    if (it == g_variants.end()) {
+        if (g_variants.size() >= kMaxVariants) {
+            return nullptr;
+        }
+        auto variant = std::make_unique<ShaderVariant>();
+        variant->key = key;
+        ShaderVariant* raw = variant.get();
+        g_variants.emplace(hash, std::move(variant));
+        g_variant_compiler.enqueue(raw);
+        return nullptr;
+    }
+    ShaderVariant& variant = *it->second;
+    if (std::memcmp(&variant.key, &key, sizeof key) != 0) {
+        return nullptr;  // hash collision: stay on the general shader
+    }
+    return variant.shader.load(std::memory_order_acquire);
+}
