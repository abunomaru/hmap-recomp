+// Parallel vertex processing (hmap-recomp engine patch 0011). Every vertex of a draw is
+// decoded, transformed, lit and texgen'd independently from state that begin_*() set up
+// for the whole draw, and all vertices of a draw have the same size, so large draws are
+// split across worker threads. Setting video.vertex_threads / WP_VERTEX_THREADS:
+// 0 = automatic (cores - 2, at most 8), 1 = off (single thread), N = N threads in total.
+class VertexPool {
+public:
+    using Work = std::function<void(uint32_t, uint32_t)>;
+
+    // Runs work(begin, end) over [begin, end) in chunks; the calling thread takes part.
+    void run(uint32_t begin, uint32_t end, const Work& work) {
+        ensure_workers();
+        if (m_workers.empty()) {
+            work(begin, end);
+            return;
+        }
+        {
+            std::lock_guard<std::mutex> hold(m_lock);
+            m_work = &work;
+            m_next.store(begin, std::memory_order_relaxed);
+            m_end = end;
+            m_active.store(static_cast<uint32_t>(m_workers.size()), std::memory_order_relaxed);
+            m_generation++;
+        }
+        m_wake.notify_all();
+        consume();
+        while (m_active.load(std::memory_order_acquire) != 0) {
+            std::this_thread::yield();
+        }
+        m_work = nullptr;
+    }
+
+    uint32_t threads() {
+        ensure_workers();
+        return static_cast<uint32_t>(m_workers.size()) + 1;
+    }
+
+private:
+    static constexpr uint32_t kChunk = 128;
+
+    void ensure_workers() {
+        if (m_started) {
+            return;
+        }
+        m_started = true;
+        static const settings::LiveNumber setting("video.vertex_threads", "WP_VERTEX_THREADS");
+        int wanted = setting();
+        uint32_t total = 1;
+        if (wanted <= 0) {
+            uint32_t cores = std::max(1u, std::thread::hardware_concurrency());
+            total = std::clamp<uint32_t>(cores > 2 ? cores - 2 : 1, 1, 8);
+        } else {
+            total = std::min<uint32_t>(static_cast<uint32_t>(wanted), 16);
+        }
+        for (uint32_t i = 1; i < total; i++) {
+            m_workers.emplace_back([this] { worker(); });
+            m_workers.back().detach();
+        }
+        log::write("gpu", "vertex processing on %u threads", total);
+    }
+
+    void consume() {
+        const Work& work = *m_work;
+        while (true) {
+            uint32_t begin = m_next.fetch_add(kChunk, std::memory_order_relaxed);
+            if (begin >= m_end) {
+                return;
+            }
+            work(begin, std::min(m_end, begin + kChunk));
+        }
+    }
+
+    void worker() {
+        uint64_t seen = 0;
+        while (true) {
+            {
+                std::unique_lock<std::mutex> hold(m_lock);
+                m_wake.wait(hold, [&] { return m_generation != seen; });
+                seen = m_generation;
+            }
+            consume();
+            m_active.fetch_sub(1, std::memory_order_release);
+        }
+    }
+
+    bool m_started = false;
+    std::vector<std::thread> m_workers;
+    std::mutex m_lock;
+    std::condition_variable m_wake;
+    uint64_t m_generation = 0;
+    const Work* m_work = nullptr;
+    std::atomic<uint32_t> m_next{0};
+    uint32_t m_end = 0;
+    std::atomic<uint32_t> m_active{0};
+};
+
+VertexPool g_vertex_pool;
+constexpr uint32_t kParallelVertexMinimum = 384;
