@@ -56,11 +56,27 @@ uint32_t g_cause_counts[kCauseCount] = {};
 double g_cause_wait_ms[kCauseCount] = {};
 uint32_t g_cause_wakes[kCauseCount] = {};
 
+Clock::time_point g_idle_since = Clock::now();
+
 void note_cause(int cause) {
     g_last_cause = cause;
     g_cause_counts[cause]++;
 }
 
+// Deliver one interrupt and credit the wake-up to it if it ended the guest's idle state
+// (patch 0009: precise attribution instead of "last interrupt before the next poll").
+template <typename Deliver>
+void deliver_counted(int cause, Deliver deliver) {
+    bool was_idle = rd32(kCurrentThread) == 0;
+    note_cause(cause);
+    deliver();
+    if (was_idle && rd32(kCurrentThread) != 0) {
+        g_cause_wakes[cause]++;
+        g_cause_wait_ms[cause] += std::chrono::duration<double, std::milli>(Clock::now() - g_idle_since).count();
+        g_idle_since = Clock::now();
+    }
+}
+
 void log_waits(Clock::time_point now) {
     static Clock::time_point last = now;
     double seconds = std::chrono::duration<double>(now - last).count();
