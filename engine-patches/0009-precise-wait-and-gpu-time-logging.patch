     if (gx::take_finish_interrupt()) {
-        note_cause(kCauseFinish);
-        deliver_external_interrupt(c, kFinishInterrupt);
+        deliver_counted(kCauseFinish, [&] { deliver_external_interrupt(c, kFinishInterrupt); });
     }
     for (int delivered = 0; delivered < 3; delivered++) {
         uint32_t index = exi::pending_interrupt();
         if (index == 0) {
             break;
         }
-        note_cause(kCauseExi);
-        deliver_external_interrupt(c, index);
+        deliver_counted(kCauseExi, [&] { deliver_external_interrupt(c, index); });
     }
     if (si::interrupt_pending()) {
-        note_cause(kCauseSerial);
-        deliver_external_interrupt(c, kSerialInterrupt);
+        deliver_counted(kCauseSerial, [&] { deliver_external_interrupt(c, kSerialInterrupt); });
