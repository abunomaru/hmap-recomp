-uint64_t time_base() {
+namespace {
+
+// Guest time = real time, except while fast-forwarding. Each speed change starts a new
+// immutable segment, so readers on any thread need one atomic load and never see a jump.
+struct SpeedSegment {
+    int64_t real_start;
+    uint64_t guest_start;
+    uint32_t factor;
+};
+
+std::atomic<const SpeedSegment*> g_speed_segment{nullptr};
+
+int64_t real_nanoseconds() {
     using clock = std::chrono::steady_clock;
     static const clock::time_point origin = clock::now();
+    return std::chrono::duration_cast<std::chrono::nanoseconds>(clock::now() - origin).count();
+}
+
+uint64_t guest_nanoseconds(int64_t real) {
+    const SpeedSegment* segment = g_speed_segment.load(std::memory_order_acquire);
+    if (!segment) {
+        return static_cast<uint64_t>(real);
+    }
+    return segment->guest_start + static_cast<uint64_t>(real - segment->real_start) * segment->factor;
+}
+
+}
+
+void set_speed(uint32_t factor) {
+    factor = std::max(1u, std::min(factor, 16u));
+    if (speed() == factor) {
+        return;
+    }
+    int64_t now = real_nanoseconds();
+    // Segments are tiny and change only on a key press; the old ones are kept so a
+    // concurrent reader never touches freed memory.
+    g_speed_segment.store(new SpeedSegment{now, guest_nanoseconds(now), factor}, std::memory_order_release);
+}
+
+uint32_t speed() {
+    const SpeedSegment* segment = g_speed_segment.load(std::memory_order_acquire);
+    return segment ? segment->factor : 1;
+}
+
+uint64_t time_base() {
     static const uint64_t start = wall_clock_ticks();
-    uint64_t elapsed = static_cast<uint64_t>(std::chrono::duration_cast<std::chrono::nanoseconds>(clock::now() - origin).count());
+    uint64_t elapsed = guest_nanoseconds(real_nanoseconds());
     return start + elapsed / 1000000000ull * kTimeBaseHz + elapsed % 1000000000ull * kTimeBaseHz / 1000000000ull;
 }
 
