diff --git a/engine/src/gpu/gx_render_common.cpp b/engine/src/gpu/gx_render_common.cpp
index 87fbd92..e064b84 100644
--- a/engine/src/gpu/gx_render_common.cpp
+++ b/engine/src/gpu/gx_render_common.cpp
@@ -5,6 +5,9 @@
 #include <cstring>
 
 #include "wp/memory.h"
+#include "wp/settings.h"
+
+#include <unordered_map>
 
 namespace wp::gx::render {
 
@@ -521,4 +524,25 @@ SamplerParams sampler_params(uint32_t map, bool custom) {
     return params;
 }
 
+bool want_write_back(uint32_t address, uint64_t frame) {
+    static const settings::LiveNumber mode("video.efb_to_ram", "WP_EFB_TO_RAM");
+    int setting = mode();
+    if (setting == 0) {
+        return false;
+    }
+    if (setting == 1) {
+        return true;
+    }
+    struct History {
+        uint64_t frame = 0;
+        uint32_t streak = 0;
+    };
+    constexpr uint32_t kEffectStreak = 3;
+    static std::unordered_map<uint32_t, History> history;
+    History& entry = history[address];
+    entry.streak = (entry.streak > 0 && frame - entry.frame <= 1) ? entry.streak + 1 : 1;
+    entry.frame = frame;
+    return entry.streak < kEffectStreak;
+}
+
 }
diff --git a/engine/src/gpu/gx_render_common.h b/engine/src/gpu/gx_render_common.h
index 4b6c87c..95b37fd 100644
--- a/engine/src/gpu/gx_render_common.h
+++ b/engine/src/gpu/gx_render_common.h
@@ -94,6 +94,15 @@ BlendState blend_state_for(uint32_t word);
 void fill_constants(Constants& constants, int scale);
 AlphaTestResult alpha_test_result(uint32_t test);
 uint32_t copy_bits(uint32_t format);
+
+// Whether an EFB copy to `address` should also be written back to guest RAM
+// (hmap-recomp engine patch 0006). Setting video.efb_to_ram / WP_EFB_TO_RAM:
+//   1 = always (exact hardware behaviour; every GXDrawDone waits for the read-backs)
+//   0 = never  (like Dolphin's "Store EFB Copies to Texture Only")
+//   2 = auto (default): an address copied again within one presented frame for
+//       kEffectStreak copies in a row is a per-frame effect (blur, glow, depth of field)
+//       and stays on the GPU; one-off copies (photos, thumbnails) are written back.
+bool want_write_back(uint32_t address, uint64_t frame);
 uint32_t copy_texture_format(uint32_t format);
 inline uint32_t scale_bits(uint32_t value, int bits) {
     return (value * ((1u << bits) - 1) + 127) / 255;
