 #pragma once
 
+#include <cstddef>
 #include <cstdint>
 #include <functional>
 
@@ -16,5 +17,9 @@ void run_frame_task(std::function<void()> task);
 // the external framebuffer since the last present, or the screen has not been refreshed for
 // a few retraces (menus, overlays). Call on the GPU thread, in order with the drawing.
 bool should_present();
+// Receives every GX byte the game sends, on the game's thread, before the engine parses it
+// (hmap-recomp engine patch 0013: used by the aurora video backend).
+using FifoTap = void (*)(const uint8_t* data, size_t size);
+void set_fifo_tap(FifoTap tap);
 
 }
