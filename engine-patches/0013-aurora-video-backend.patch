--- a/engine/CMakeLists.txt
+++ b/engine/CMakeLists.txt
@@ -41,7 +41,23 @@ add_library(wp_engine STATIC
     src/platform/mii.cpp
     src/platform/options_window.cpp
 )
-if(WIN32)
+# aurora renderer (hmap-recomp engine patch 0013): aurora owns the window and draws; the
+# engine keeps parsing GX with the null renderer for its interrupts and register state.
+option(WP_AURORA "Render through aurora (Dawn: D3D12/Vulkan/Metal) instead of the built-in renderers" OFF)
+set(WP_AURORA_DIR "" CACHE PATH "aurora source directory")
+set(WP_BRIDGE_DIR "" CACHE PATH "hmap-recomp bridge directory (aurora_bridge.cpp, video_aurora.cpp)")
+if(WP_AURORA)
+    set(AURORA_ENABLE_TESTS OFF CACHE BOOL "" FORCE)
+    set(AURORA_ENABLE_RMLUI OFF CACHE BOOL "" FORCE)
+    set(AURORA_ENABLE_DVD OFF CACHE BOOL "" FORCE)
+    set(AURORA_ENABLE_CARD OFF CACHE BOOL "" FORCE)
+    add_subdirectory("${WP_AURORA_DIR}" "${CMAKE_BINARY_DIR}/aurora" EXCLUDE_FROM_ALL)
+    target_sources(wp_engine PRIVATE "${WP_BRIDGE_DIR}/aurora_bridge.cpp" "${WP_BRIDGE_DIR}/video_aurora.cpp" src/gpu/null_render.cpp)
+    target_include_directories(wp_engine PRIVATE "${WP_BRIDGE_DIR}")
+    # aurora's core, GX and VI libraries reference each other: let the linker rescan them.
+    target_link_libraries(wp_engine PUBLIC "$<LINK_GROUP:RESCAN,aurora_core,aurora_gx,aurora_vi>")
+    target_compile_definitions(wp_engine PRIVATE WP_AURORA)
+elseif(WIN32)
     target_sources(wp_engine PRIVATE src/gpu/gx_render.cpp src/platform/video.cpp)
 endif()
