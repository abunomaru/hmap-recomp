+bool should_present_now() {
+    // A 30 fps game gets 60 retraces a second; presenting the same image twice costs the
+    // graphics card a full-screen pass for nothing. Still present every 4th retrace so
+    // the options menu, hints and window resizes keep updating.
+    static uint32_t since_last = 0;
+    bool fresh = g_new_xfb.exchange(false);
+    if (fresh || ++since_last >= 4 || options::menu_open()) {
+        since_last = 0;
+        return true;
+    }
+    g_repeat_presents++;
+    return false;
+}
